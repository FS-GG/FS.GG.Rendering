<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>FS.GG.UI.Scene</PackageId>
    <AssemblyName>FS.GG.UI.Scene</AssemblyName>
    <Title>FS.GG.UI.Scene</Title>
    <Description>Dependency-light scene vocabulary for FS.GG.UI V3 products.</Description>
    <PackageTags>fsharp;scene;ui;svg;fable-javascript;fable-dotnet</PackageTags>
    <FablePackageType>library</FablePackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Package.SDK"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!-- The normal assembly retains the complete Scene implementation. Fable consumers receive the
       same canonical types plus the portable retained contract/reducer only; codec, hashing,
       inspection, animation and text-shaping implementations remain outside the browser graph. -->
  <Target Name="CurateFableCompatibilityView"
          AfterTargets="CreateFablePackageFiles">
    <ItemGroup>
      <_PackageFiles Remove="@(_PackageFiles)" />
      <_PackageFiles Include="Types.fsi;Types.fs;RetainedSvg.fsi;RetainedSvg.fs;SvgDocument.fsi;SvgDocument.fs">
        <Pack>true</Pack>
        <PackagePath>fable/%(Filename)%(Extension)</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
      <_PackageFiles Include="Fable/FS.GG.UI.Scene.fsproj">
        <Pack>true</Pack>
        <PackagePath>fable/FS.GG.UI.Scene.fsproj</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
    </ItemGroup>
  </Target>

  <ItemGroup Label="fable-compatibility-metadata">
    <None Include="Fable/compatibility-profile.v1.json"
          Pack="true"
          PackagePath="fable-compatibility/compatibility-profile.v1.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Types.fsi" />
    <Compile Include="Types.fs" />
    <Compile Include="RetainedSvg.fsi" />
    <Compile Include="RetainedSvg.fs" />
    <Compile Include="SvgDocument.fsi" />
    <Compile Include="SvgDocument.fs" />
    <Compile Include="TextShaping.fsi" />
    <Compile Include="TextShaping.fs" />
    <Compile Include="Scene.fsi" />
    <Compile Include="Scene.fs" />
    <Compile Include="Inspection.fsi" />
    <Compile Include="Inspection.fs" />
    <Compile Include="Evidence.fsi" />
    <Compile Include="Evidence.fs" />
    <Compile Include="SceneWire.fs" />
    <Compile Include="SceneCodec.fsi" />
    <Compile Include="SceneCodec.fs" />
    <Compile Include="Animation.fsi" />
    <Compile Include="Animation.fs" />
  </ItemGroup>

</Project>
