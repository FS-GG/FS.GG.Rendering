    <Compile Include="SpatialWorkingSet.fs" />
    <Compile Include="SvgDocument.fsi" />
    <Compile Include="SvgDocument.fs" />
    <Compile Include="SvgAuthoring.fsi" />
    <Compile Include="SvgAuthoring.fs" />
    <Compile Include="SvgScene.fsi" />
    <Compile Include="SvgScene.fs" />
    <Compile Include="SvgArt.fsi" />
    <Compile Include="SvgArt.fs" />
    <Compile Include="SvgWorkspace.fsi" />
    <Compile Include="SvgWorkspace.fs" />
    <Compile Include="Animation.fsi" />
    <Compile Include="Animation.fs" />
  </ItemGroup>
</Project>
