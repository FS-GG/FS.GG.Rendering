<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>FS.GG.UI.Scene.SvgBrowser</PackageId>
    <AssemblyName>FS.GG.UI.Scene.SvgBrowser</AssemblyName>
    <Title>FS.GG.UI.Scene.SvgBrowser</Title>
    <Description>Retained and identified-document SVG DOM adapter for the portable FS.GG.UI.Scene contract.</Description>
    <PackageTags>fsharp;scene;svg;browser;fable-javascript</PackageTags>
    <FablePackageType>library</FablePackageType>
  </PropertyGroup>
  <Target Name="CurateFableCompatibilityView" AfterTargets="CreateFablePackageFiles">
    <ItemGroup>
      <_PackageFiles Remove="@(_PackageFiles)" />
      <_PackageFiles Include="SvgBrowser.fsi;SvgBrowser.fs;SvgStudio.fsi;SvgStudio.fs">
        <Pack>true</Pack>
        <PackagePath>fable/%(Filename)%(Extension)</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
      <_PackageFiles Include="Fable/FS.GG.UI.Scene.SvgBrowser.fsproj">
        <Pack>true</Pack>
        <PackagePath>fable/FS.GG.UI.Scene.SvgBrowser.fsproj</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
    </ItemGroup>
  </Target>
  <ItemGroup Label="fable-compatibility-metadata">
    <None Include="Fable/compatibility-profile.v1.json" Pack="true" PackagePath="fable-compatibility/compatibility-profile.v1.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="SvgBrowser.fsi" />
    <Compile Include="SvgBrowser.fs" />
    <Compile Include="SvgStudio.fsi" />
    <Compile Include="SvgStudio.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="svg-geometry-worker.js" Pack="true" PackagePath="contentFiles/any/any/svg-geometry-worker.js" />
    <None Include="package.json" Pack="true" PackagePath="contentFiles/any/any/package.json" />
    <None Include="package-lock.json" Pack="true" PackagePath="contentFiles/any/any/package-lock.json" />
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
    <None Include="OFL-Noto-Sans.txt" Pack="true" PackagePath="OFL-Noto-Sans.txt" />
    <None Include="font-resource-manifest.json" Pack="true" PackagePath="contentFiles/any/any/font-resource-manifest.json" />
    <None Include="noto-sans-latin-400-normal.woff2.base64" Pack="true" PackagePath="contentFiles/any/any/noto-sans-latin-400-normal.woff2.base64" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Scene\Scene.fsproj" />
    <ProjectReference Include="..\KeyboardInput\KeyboardInput.fsproj" />
    <PackageReference Include="Fable.Browser.Dom" />
    <PackageReference Include="Fable.Package.SDK" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
</Project>
