<!-- TRANSIENT — DELETE THIS FILE ONCE FS.GG.UI.Controls 0.10.0 IS ON THE ORG FEED.

     The Controls half of the same #537 transient the Canvas file carries; that file states the full
     rationale. In short: the ApiCompat gate baselines off the PUBLISHED feed, so removing a shipped
     member is a CP0002 break vs 0.9.0 no matter what version the tree calls itself, and the required
     gate would wedge the merge. Once 0.10.0 publishes, the baseline moves and nothing is left to
     suppress.

     `TextInput.interpretEffect` returned `None` for every case and no implementation could have done
     better — no `TextInputEffect` case carries a host result to map back into a `TextInputMsg`. It was
     dead, not unfinished, and `[<Obsolete>]` said so since #445. -->

<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Suppression>
    <DiagnosticId>CP0002</DiagnosticId>
    <Target>M:FS.GG.UI.Controls.TextInput.interpretEffect(FS.GG.UI.Controls.TextInputEffect)</Target>
    <Left>lib/net10.0/FS.GG.UI.Controls.dll</Left>
    <Right>lib/net10.0/FS.GG.UI.Controls.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
  </Suppression>
</Suppressions>