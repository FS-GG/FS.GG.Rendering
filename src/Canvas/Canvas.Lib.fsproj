<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>FS.GG.UI.Canvas</PackageId>
    <AssemblyName>FS.GG.UI.Canvas</AssemblyName>
    <Title>FS.GG.UI.Canvas</Title>
    <!-- 0.2.0 major (ADR-0022 P5): the deterministic sim primitives (Rng/FixedStep/Pathfinding/
         SpatialGrid) moved OUT to FS.GG.Game.Core (the new bottom layer). Canvas now carries only
         the render-adjacent surfaces: pure Elements, the render Loop, and the Persistence request
         vocabulary.
         ^ "the render Loop" was an implementation-time judgement recorded here and ratified nowhere:
         ADR-0022 never mentions Loop. ADR-0104 (Rendering#269) superseded it — the fixed-step double
         buffer is a SIMULATION primitive owned by FS.GG.Game.Core.Loop. Canvas.Loop/StepState were
         deprecated (#269 step 3-4 / #317) and are REMOVED here; the retirement rides the next FS.GG.UI
         framework major, 0.6.0 (0.5.0 already shipped carrying them) — ADR-0104 decision 5, Rendering#319.
         Canvas then carries pure Elements and the Persistence request vocabulary.
         0.3.0 major (ADR-0024): the Audio request surface (AudioEffect/SoundId/TrackId/Audio.*) is
         RETIRED from Canvas — its single vocabulary now lives in the standalone FS.GG.Audio.Core
         (a breaking removal; the extraction completed under Rendering#158). -->
    <Description>Dependency-light pure element library and Persistence request surface for FS.GG.UI canvas products.</Description>
    <PackageTags>fsharp;skia;scene;canvas;ui;persistence</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Canvas.Tests" />
  </ItemGroup>

  <!-- Pure element/loop helpers. Scene-only dependency (plan Structure Decision):
       keeps game/element content off the core control surface and headlessly testable. -->
  <ItemGroup>
    <Compile Include="Elements.fsi" />
    <Compile Include="Elements.fs" />
    <Compile Include="Persistence.fsi" />
    <Compile Include="Persistence.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scene\Scene.fsproj" />
  </ItemGroup>

</Project>
