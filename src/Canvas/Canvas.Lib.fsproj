<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>FS.GG.UI.Canvas</PackageId>
    <AssemblyName>FS.GG.UI.Canvas</AssemblyName>
    <Version>0.2.0-preview.1</Version>
    <Title>FS.GG.UI.Canvas</Title>
    <!-- 0.2.0 major (ADR-0022 P5): the deterministic sim primitives (Rng/FixedStep/Pathfinding/
         SpatialGrid) moved OUT to FS.GG.Game.Core (the new bottom layer). Canvas now carries only
         the render-adjacent surfaces: pure Elements, the render Loop, and the Audio/Persistence
         request vocabularies. -->
    <Description>Dependency-light pure element library, render loop, and Audio/Persistence request surfaces for FS.GG.UI canvas products.</Description>
    <PackageTags>fsharp;skia;scene;canvas;ui;audio;persistence</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Canvas.Tests" />
  </ItemGroup>

  <!-- Pure element/loop helpers. Scene-only dependency (plan Structure Decision):
       keeps game/element content off the core control surface and headlessly testable. -->
  <ItemGroup>
    <Compile Include="Elements.fsi" />
    <Compile Include="Elements.fs" />
    <Compile Include="Loop.fsi" />
    <Compile Include="Loop.fs" />
    <Compile Include="Audio.fsi" />
    <Compile Include="Audio.fs" />
    <Compile Include="Persistence.fsi" />
    <Compile Include="Persistence.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scene\Scene.fsproj" />
  </ItemGroup>

</Project>
