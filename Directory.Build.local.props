<Project>

  <!-- Repo-owned MSBuild overrides for FS.GG.Rendering. Imported LAST by the canonical
       Directory.Build.props (org-shared, synced from FS-GG/.github). Everything specific to this
       repo lives here; the canonical file owns Determinism, CPM enablement + transitive pinning, and
       the whole lockfile-restore-enforcement block (the locked-restore gate, now keyed on the
       GITHUB_ACTIONS CI signal, plus the NU1603;NU1608 promotions). Feature 213 (H3 / ADR-0006). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- APPEND-form (Feature 213 / research R3): the canonical Directory.Build.props sets
         WarningsAsErrors to include NU1603;NU1608 BEFORE importing this file. Appending here
         (rather than assigning an absolute list) preserves those canonical NU promotions; an
         absolute assignment would silently disable silent-substitution enforcement. -->
    <WarningsAsErrors>$(WarningsAsErrors);FS0025;FS0026;FS0052;FS0064</WarningsAsErrors>
    <!-- Principle II: visibility lives in .fsi, not in .fs.
         FS0078 would warn on `private` or `internal` on top-level bindings
         in a file that has a companion .fsi. We promote it to error. -->
    <WarningsAsErrors>$(WarningsAsErrors);FS0078</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <!-- THE LOCAL-PACK AXIS — NOT the version anything publishes at, and NOT a number to bump when
         the framework releases. The ONE definition for all 17 packable projects under src/ (#866);
         they carried this literal inline, 17 identical copies, and #815 read one of them as a
         package's published version and scoped a Diagnostics-only major against it. There is no such
         cut: the 17 move together or not at all.

         WHAT PUBLISHES. release.yml packs the whole slnx with `-p:Version=$pin`, where
         $pin = <FsGgUiVersion> in template/base/Directory.Packages.props. That switch overrides this
         property for every one of the 17, so the value here NEVER reaches a public feed. To find what
         a package actually ships at, read <FsGgUiVersion> — not this line, and not a number quoted
         here (which would be one more version literal to rot, the very thing #866 removed).

         WHY IT IS DELIBERATELY NOT $(FsGgUiVersion). Package-consuming samples restore FS.GG.UI.*
         from a LOCAL feed of freshly-packed bytes. Because this version is published nowhere, a
         sample can only ever resolve the local pack: a stale or missing feed fails loudly instead of
         silently succeeding against the real released package and testing bytes nobody built here.
         Tracking $(FsGgUiVersion) would surrender that and add a 17-way keep-in-step to the axis that
         wedged #611/#848.

         SAMPLE PINS MIRROR THIS VALUE and are GENERATED — if you change it, regenerate them by
         running the Rendering.Harness `package-feed` command with mode set to refresh (flag written
         without its leading dashes here because XML comments forbid a double dash: it is the `mode`
         option with value `refresh`); gate.yml's "Sample pins mirror src <Version>" step (#300) is
         what fails if you do not. Projects inherit this by omission (PackageFeed.resolveProjectVersion,
         #677); .template.package/FS.GG.UI.Template.fsproj is NOT one of them — it is not a slnx
         member and ships on the release-tag axis, so it keeps its own inline <Version>. -->
    <Version>0.4.0-preview.1</Version>
    <Authors>FS.GG Contributors</Authors>
    <Company>FS.GG Contributors</Company>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/FS-GG/FS.GG.Rendering</PackageProjectUrl>
    <!-- 064 (FR-010): a public nuget.org listing requires a RepositoryUrl distinct from
         PackageProjectUrl; shared here so every packable project carries it. -->
    <RepositoryUrl>https://github.com/FS-GG/FS.GG.Rendering.git</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 064 (FR-010): pack each project's own README.md as the package listing readme when it
         exists. Conditional so non-packable / readme-less projects are unaffected; the
         pre-publish check (RequiredMetadata) enforces that every packable project has one. -->
    <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)/README.md')">README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- 076 (FR-001/FR-003): fsdocs documentation-site properties. These configure the
       FSharp.Formatting build only; they do NOT touch package identity. Per research R2
       decision (ii) the fsdocs source-link is set via FsDocs* properties so the published
       PackageProjectUrl/RepositoryUrl metadata is left undisturbed. GenerateDocumentationFile
       is already true above, so XML doc emission is on for the API reference. -->
  <PropertyGroup Label="FsDocs">
    <!-- FR-003 / SC-001: a missing summary on a supported public member becomes an fsdocs
         warning; under a strict fsdocs build it fails the build (zero empty stubs). -->
    <FsDocsWarnOnMissingDocs>true</FsDocsWarnOnMissingDocs>
    <FsDocsTheme>default</FsDocsTheme>
    <!-- Source/"edit" links point at the ACTUAL remote (EHotwagner) rather than the
         aspirational PackageProjectUrl org, without rewriting package metadata. -->
    <FsDocsSourceRepository>https://github.com/FS-GG/FS.GG.Rendering/tree/main</FsDocsSourceRepository>
    <FsDocsLicenseLink>https://github.com/FS-GG/FS.GG.Rendering/blob/main/LICENSE</FsDocsLicenseLink>
    <FsDocsReleaseNotesLink>https://github.com/FS-GG/FS.GG.Rendering/blob/main/CHANGELOG.md</FsDocsReleaseNotesLink>
    <!-- Real logo/favicon assets so the header shows a mark, not a broken placeholder. -->
    <FsDocsLogoSource>img/logo.svg</FsDocsLogoSource>
    <FsDocsFaviconSource>img/logo.svg</FsDocsFaviconSource>
  </PropertyGroup>

  <!-- api-breaking-change-gate (H3 / FS-GG/.github#20, epic #16 Pillar 5). The FS.GG.UI.* packages
       are F#, so the operative breaking-change detector is the .NET SDK's Package Validation /
       ApiCompat (assembly+package level) — Microsoft.CodeAnalysis.PublicApiAnalyzers is a Roslyn/C#
       source analyzer and does not analyze F# (registry coherence id apicompat-publicapi-gate;
       FS.GG.Governance spec 088 D1). The source-level public-surface record stays the committed .fsi
       baselines under readiness/surface-baselines/ (a separate gate).
       Package Validation is left OFF for the normal build/release pack on purpose: it emits MSBuild
       ERRORS on a break, which would redden `dotnet pack` and split enforcement from the advisory
       signal. The detector runs as a SEPARATE, advisory step — scripts/apicompat-check.sh, wired as
       the non-required `api-compatibility-gate` job in gate.yml — which turns Package Validation on
       per-pack against the feed baseline and reports breaks without blocking the merge. -->
  <PropertyGroup>
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <!-- 186: the .NET SDK's F# targets append `FSharp/library-packs` to RestoreAdditionalProjectSources
       (Microsoft.FSharp.NetSdk.targets), and that folder ships an FSharp.Core nupkg with the same
       VERSION as nuget.org's but different BYTES. With both sources live, which artifact restore
       installs — and therefore the contentHash recorded in packages.lock.json — depends on the
       installed SDK patch and on which source answers first. Disabling the implicit folder makes
       nuget.config (`<clear />` + nuget.org) the whole truth, so the committed lockfiles are
       reproducible across machines and across SDK patch bumps. -->
  <PropertyGroup Label="lockfile-restore-enforcement">
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
  </PropertyGroup>

  <!-- FSharp.Core resolves its version from the org baseline in the canonical
       Directory.Packages.props (CPM); this version-less reference just adds the package. -->
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <!-- ══ PACKAGE CONTENT — what goes INTO the nupkg, beyond lib/. Keep these together. ══ -->

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- #752 — every packable project SHIPS ITS OWN SIGNATURE FILES, under `api-surface/` in the nupkg.
       This is the input the mirror generator (#694's epic) restores and reads.

       WHY THE PACKAGE AND NOT `src/`. The scaffold's `template/base/docs/api-surface/**` mirrors what a
       scaffolded product actually RESTORES — the pin — and `src/` is AHEAD of the pin for the whole window
       between a feature landing on `main` and the release that publishes it. That window was the entire
       reason `tests/Package.Tests/mirror-pending-release-ledger.txt` existed. Generating from the pin
       closes it by construction — the mirror cannot name a symbol the pin does not export — so #753
       deleted the ledger, and M-MIR/TYPE, the rule it existed to hold open.

       WHY THE .fsi AND NOT THE METADATA. A PE/metadata walk was the plan, and it cannot work. An `.fsi`
       needs SIGNATURES, and the walk yields NAMES. F# type ABBREVIATIONS (`type CommandId = string`) compile
       to literally nothing in IL, so no metadata reader can ever recover them — and the mirror declares five.
       Shipping the `.fsi` is faithful BY CONSTRUCTION: it IS the signature file, as the compiler checked it,
       and it needs no FSharp.Compiler.Service (excluded by FR-008/FR-012).

       `api-surface/` is an INERT folder: NuGet auto-consumes `lib/`, `build/`, `contentFiles/`, `tools/` and
       friends, so a custom top-level folder is carried in the nupkg and never fed to a consumer's compiler.
       Nothing a restoring product builds changes because of this.

       NOT sufficient on its own, and deliberately so: the mirror is CURATED — 96 `src/*.fsi` are merged into
       62 mirror files (`src/Scene/` is 7 files merged into 1), and 61 of the 62 carry a `// See skill:`
       pointer the M-PTR gate REQUIRES that no `src/*.fsi` has. The package can carry the signatures; it can
       never carry the curation. The generator therefore takes these files PLUS a checked-in merge/pointer
       manifest, and this half is the prerequisite for that half.

       `scripts/check-packed-api-surface.fsx` proves the nupkg matches the source exactly; `release.yml` runs
       it immediately before `dotnet nuget push`, which is the last moment a missing `.fsi` is still fixable. -->
  <ItemGroup Label="api-surface (#752)"
             Condition="'$(IsPackable)' != 'false' And '$(PackageId)' != ''">
    <!-- CONDITIONED ON `!= 'false'`, NOT ON `== 'true'`. `IsPackable` DEFAULTS to true, and the SDK applies
         that default in its .targets — i.e. AFTER item evaluation — so at this point the property is simply
         EMPTY for any project that does not set it by hand. A `== 'true'` test therefore silently skips a
         project that is packable by default: it would ship a package with no `.fsi` in it, and the guard
         script would not judge it either, because the script reads this same rule. Both halves would agree,
         and both would be wrong — the #661 shape. Matching the SDK's real default (`!= 'false'`) removes the
         disagreement; requiring a `<PackageId>` keeps the item off the tests/tools/samples that never pack.
         (`$(PackageId)` is likewise only set here if the project body sets it explicitly — which every one of
         the 17 packables does; the SDK's AssemblyName fallback also lands in .targets, too late to see.)

         This ItemGroup is evaluated in the ITEM pass, which runs after every property in the import graph is
         set, so it correctly observes the `<IsPackable>`/`<PackageId>` the project body declares BELOW this
         file's import. The canonical Directory.Build.props documents that same property-vs-item asymmetry on
         its api-gate block, where it is a hazard; here it is what makes the condition work at all. -->

    <!-- The PackagePath is the file's FULL target path, spelled out — NOT a folder.
         `PackagePath="api-surface/%(RecursiveDir)"` (with the trailing slash) reads to NuGet as a DIRECTORY,
         so it appends the file's own recursive path a second time and `Widgets/Buttons.fsi` packs to
         `api-surface/Widgets/Widgets/Buttons.fsi` — the subdirectory doubled. Silent, and wrong in exactly
         the 17 nested cases (`Controls/Widgets/`, `SkiaViewer/Host/`) the generator most needs to map back to
         a mirror file. Naming `%(Filename)%(Extension)` explicitly leaves NuGet nothing to append. -->
    <None Include="$(MSBuildProjectDirectory)/**/*.fsi"
          Exclude="$(MSBuildProjectDirectory)/bin/**;$(MSBuildProjectDirectory)/obj/**"
          Pack="true"
          PackagePath="api-surface/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
