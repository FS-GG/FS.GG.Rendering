<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LoopTests.fs" />
    <Compile Include="RngTests.fs" />
    <Compile Include="FixedStepTests.fs" />
    <Compile Include="PathfindingTests.fs" />
    <Compile Include="SpatialGridTests.fs" />
    <Compile Include="ElementsTests.fs" />
    <Compile Include="AudioTests.fs" />
    <Compile Include="PersistenceTests.fs" />
    <Compile Include="CanvasDemoTests.fs" />
    <!-- Feature 246 (US1): compile the raw import-and-adapt collision helper source (literal
         `namespace Product`, the default sourceName) so its logic is tested framework-side. -->
    <Compile Include="..\..\template\fragments\collision\src\Product\Collision.fs" />
    <Compile Include="CollisionHelperTests.fs" />
    <!-- Feature 247 (US1): compile the raw import-and-adapt visibility helper source (literal
         `namespace Product`, the default sourceName) so its logic is tested framework-side. -->
    <Compile Include="..\..\template\fragments\visibility\src\Product\Visibility.fs" />
    <Compile Include="VisibilityHelperTests.fs" />
    <!-- Feature 249 (US1): compile the raw import-and-adapt grid-parts helper source (literal
         `namespace Product`, the default sourceName) so its logic is tested framework-side. -->
    <Compile Include="..\..\template\fragments\grids\src\Product\Grids.fs" />
    <Compile Include="GridsHelperTests.fs" />
    <!-- Feature 248 (US1): compile the raw import-and-adapt line-drawing helper source (literal
         `namespace Product`, the default sourceName) so its logic is tested framework-side. -->
    <Compile Include="..\..\template\fragments\line-drawing\src\Product\LineDrawing.fs" />
    <Compile Include="LineDrawingHelperTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Canvas\Canvas.Lib.fsproj" />
    <ProjectReference Include="..\..\src\Scene\Scene.fsproj" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="FsCheck" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
  </ItemGroup>

</Project>
