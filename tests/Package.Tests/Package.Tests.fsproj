<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <!-- #540 — this project is LOCKED like every other slnx member, and the opt-out that used to sit here
       is gone. It read:

         "211 (FR-006): release-only lane … Opt out of the lockfile so it is never locked (its FS.GG.UI.*
          preview pins churn every merge)."

       Both halves stopped being true. It is no longer a release-only lane (#540 made it a slnx member, so
       its hermetic default tier runs on every PR), and it has not had an FS.GG.UI.* PackageReference to
       churn since #453 bound them by ProjectReference instead — see the ItemGroup below: the only packages
       it pins are Expecto, FS.GG.Contracts and the test SDKs, all centrally versioned and all stable.

       The opt-out outlived its reason by two features and nothing noticed, because the thing that would
       have noticed — RestoreLockTests' VR-1, "every slnx member has a committed packages.lock.json" — is
       scoped to slnx members, and this project was not one. That is #540's whole thesis in miniature. -->


  <ItemGroup>
    <Compile Include="SurfaceAreaTests.fs" Condition="Exists('SurfaceAreaTests.fs')" />
    <Compile Include="PackageApiReferenceTests.fs" />
    <Compile Include="NameCollisionSafetyTests.fs" />
    <Compile Include="GeneratedConsumerValidationTests.fs" />
    <Compile Include="FsiTranscriptCoverageTests.fs" />
    <Compile Include="Feature146CompatibilityLedgerTests.fs" />
    <Compile Include="Feature147CompatibilityLedgerTests.fs" />
    <Compile Include="Feature150CompatibilityLedgerTests.fs" />
    <Compile Include="Feature151CompatibilityLedgerTests.fs" />
    <Compile Include="CompatibilityLedgerTests.fs" />
    <Compile Include="Feature163PackageFeedValidationTests.fs" />
    <Compile Include="Feature170RetainedInspectionSurfaceTests.fs" />
    <Compile Include="Feature170CompatibilityTests.fs" />
    <Compile Include="Feature151PackageValidationTests.fs" />
    <Compile Include="Feature128DesignSystemTemplateTests.fs" />
    <Compile Include="Feature204LifecycleTemplateTests.fs" />
    <Compile Include="Feature205TemplateSideEffectTests.fs" />
    <Compile Include="Feature207BomMembershipTests.fs" />
    <Compile Include="Feature207BomConsumerTests.fs" />
    <Compile Include="Feature209VersionCoherenceTests.fs" />
    <Compile Include="TemplatePayloadPinsWaiverTests.fs" />
    <Compile Include="Feature217ProductNameTemplateTests.fs" />
    <Compile Include="Feature219EmitFrameworkSkillsTests.fs" />
    <Compile Include="Feature224SkillCatalogCurrencyTests.fs" />
    <Compile Include="Feature225ProductSkillVocabularyTests.fs" />
    <!-- Feature 231: the vendored standalone materialize algorithm (template CONTENT, compiled
         here solely so the G-PARITY gate can compare it against the published FS.GG.Contracts
         library — ADR-0014 / roadmap §6 "two lanes, one algorithm"). -->
    <Compile Include="..\..\template\lifecycle\skill-mirror-vendored.fs" Link="skill-mirror-vendored.fs" />
    <Compile Include="Feature231SkillManifestTests.fs" />
    <Compile Include="Feature238SkillMaterializesWhenTests.fs" />
    <Compile Include="Feature240GameCoreSkillTests.fs" />
    <Compile Include="AudioProfileWiringTests.fs" />
    <Compile Include="AudioSkillSurfaceTests.fs" />
    <Compile Include="ApiSurfaceMirrorTests.fs" />
    <Compile Include="SkillPackageReachTests.fs" />
    <Compile Include="Feature541FrozenMirrorGuardTests.fs" />
    <!-- #507 — S-DOC, the mirror image of SkillPackageReachTests' R-REACH: R-REACH stops a skill naming a
         package the product was not given; S-DOC stops a package the product WAS given going undocumented
         by accident. They belong next to each other and are read together. -->
    <Compile Include="SurfaceDocCoverageTests.fs" />
    <Compile Include="Feature246CollisionSkillTests.fs" />
    <Compile Include="Feature247VisibilitySkillTests.fs" />
    <Compile Include="Feature249GridsSkillTests.fs" />
    <Compile Include="Feature248LineDrawingSkillTests.fs" />
    <Compile Include="Feature250CollisionSafeVec2Tests.fs" />
    <Compile Include="SwapChecklistTemplateTests.fs" />
    <Compile Include="ScaffoldIdentifierLeakGuardTests.fs" />
    <Compile Include="Feature264FragmentProseTests.fs" />
    <Compile Include="Feature282EmbeddedTokenGuardTests.fs" />
    <Compile Include="Issue496FSharpCoreShadowingTests.fs" />
    <Compile Include="Tests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 453: SurfaceAreaTests binds the FS.GG.UI.Build baselines by type, like every other package
         baseline here. Without this reference the assembly is not built by `dotnet test` on this
         project alone, and the Build baselines red in any fresh worktree or clean clone. -->
    <ProjectReference Include="..\..\src\Build\FS.GG.UI.Build.fsproj" Condition="Exists('..\..\src\Build\FS.GG.UI.Build.fsproj')" />
    <ProjectReference Include="..\..\src\Scene\Scene.fsproj" Condition="Exists('..\..\src\Scene\Scene.fsproj')" />
    <ProjectReference Include="..\..\src\Diagnostics\Diagnostics.fsproj" Condition="Exists('..\..\src\Diagnostics\Diagnostics.fsproj')" />
    <ProjectReference Include="..\..\src\SkiaViewer\SkiaViewer.fsproj" Condition="Exists('..\..\src\SkiaViewer\SkiaViewer.fsproj')" />
    <ProjectReference Include="..\..\src\Testing\Testing.fsproj" Condition="Exists('..\..\src\Testing\Testing.fsproj')" />
    <ProjectReference Include="..\..\src\Layout\Layout.fsproj" Condition="Exists('..\..\src\Layout\Layout.fsproj')" />
    <ProjectReference Include="..\..\src\Controls\Controls.fsproj" Condition="Exists('..\..\src\Controls\Controls.fsproj')" />
    <ProjectReference Include="..\..\tools\Rendering.Harness\Rendering.Harness.fsproj" />
    <ProjectReference Include="..\TestSupport\TestSupport.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" />
    <!-- Feature 231: the published contract authority the G-PARITY gate compares the vendored
         template/lifecycle copy against (test-only; exact central pin in Directory.Packages.local.props). -->
    <PackageReference Include="FS.GG.Contracts" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
  </ItemGroup>

</Project>
