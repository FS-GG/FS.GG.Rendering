<Project Sdk="Microsoft.NET.Sdk">

  <!-- Feature 178 (US1, R4): non-packed shared test-support assembly. Holds the single
       repository-root finder consumed by every project under `tests/` — NOT by `samples/**/*.Tests`,
       which are test projects this assembly structurally cannot reach (#725: they consume the
       published packages, so a ProjectReference here would puncture the shadowing isolation they
       exist to prove). See RepositoryRoot.fs. IsPackable=false guarantees it never becomes an
       FS.GG.UI.* package; IsTestProject=false keeps it off the test runner (it ships helpers, not
       tests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RepositoryRoot.fs" />
    <Compile Include="MarkdownFences.fs" />
    <Compile Include="SurfaceSignature.fs" />
    <Compile Include="ScaffoldSources.fs" />
    <Compile Include="SelfProvision.fs" />
  </ItemGroup>

</Project>
