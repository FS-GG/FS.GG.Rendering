<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <!-- Expecto suite. Lives OUTSIDE the default test tier (not in FS.GG.Rendering.slnx);
       its deterministic suites (build-outcome, determinism, degrade, coverage, validation)
       are the CI-facing signal and never depend on a display (FR-014). -->
  <!-- Test suites added per user story (US1 build-outcome+determinism, US2 validation,
       US4 degrade, US5 coverage-backlog). Main.fs is the Expecto entry point. -->
  <ItemGroup>
    <Compile Include="BuildOutcomeTests.fs" />
    <Compile Include="DeterminismTests.fs" />
    <Compile Include="ValidationTests.fs" />
    <Compile Include="DegradeTests.fs" />
    <Compile Include="CoverageBacklogTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SampleApps.Core\SampleApps.Core.fsproj" />
  </ItemGroup>
  <!-- The committed coverage report, placed next to the test binary so CoverageBacklogTests can read
       it without ascending the tree to hunt for it (#725). `..` is the sample tree root — the
       directory holding Directory.Build.props / nuget.config — so this stays inside the standalone
       sample and a copied-out tree still works. PreserveNewest re-copies whenever the committed file
       changes, so the suite always judges what is actually committed. -->
  <ItemGroup>
    <None Include="..\coverage-backlog.md" Link="coverage-backlog.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FS.GG.UI.Controls" Version="0.4.0-preview.1" />
    <PackageReference Include="FS.GG.UI.Controls.Elmish" Version="0.4.0-preview.1" />
    <PackageReference Include="FS.GG.UI.SkiaViewer" Version="0.4.0-preview.1" />
    <PackageReference Include="Expecto" Version="11.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.0" />
  </ItemGroup>
</Project>