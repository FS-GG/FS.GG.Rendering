<Project>
  <!-- Repo-owned CPM PackageVersion items for FS.GG.Rendering. Imported LAST by the canonical
       Directory.Packages.props (org-shared, synced from FS-GG/.github). The canonical file owns
       ManagePackageVersionsCentrally + CentralPackageTransitivePinningEnabled and the org baseline
       (FSharp.Core 10.1.301) — a package pinned there MUST NOT be re-declared here (CPM raises a
       duplicate-PackageVersion error). Feature 213 (H3 / ADR-0006). -->
  <!-- External runtime dependencies used by packable source projects.
       NOTE: FSharp.Core is NOT declared here — it resolves from the org baseline in the canonical
       Directory.Packages.props (Feature 213; a local duplicate raises NU1506). -->
  <ItemGroup>
    <!-- FS.GG.Audio.Core (standalone repo, own version axis): the pure AudioEffect vocabulary.
         SkiaViewer references it so `ViewerEffect.PlayAudio` can carry the request values a
         product's `update` emits, and so `runAppWithAudio` can take an `AudioEffect list -> unit`
         sink. Core ONLY — Audio.Host/Engine (IAudioBackend, OpenAL, buses) stay out of the
         rendering core; the generated template supplies the backend at its own boundary. -->
    <PackageVersion Include="FS.GG.Audio.Core" Version="0.1.0" />
    <PackageVersion Include="Fable.Elmish" Version="5.0.2" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Win32" Version="14.2.1" />
    <PackageVersion Include="Silk.NET.Input" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.GLFW" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Windowing.Glfw" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Windowing.Extensions" Version="2.23.0" />
    <PackageVersion Include="SkiaSharp" Version="4.150.0" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="4.150.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.150.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.150.0" />
    <PackageVersion Include="Yoga.Net" Version="3.2.3" />
  </ItemGroup>
  <!-- Test-only dependencies. Repo-owned FS.Skia.UI package versions are not declared here.
       FS.GG.Contracts (Feature 231): the published skill-mirror contract authority the
       Package.Tests parity gate compares the vendored template/lifecycle copy against
       (ADR-0014 / roadmap §6). Exact pin; test-only; NOT shipped in any product. -->
  <ItemGroup>
    <PackageVersion Include="FS.GG.Contracts" Version="[1.4.0]" />
    <!-- ADR-0022 P5: the game-sim primitives (Rng/FixedStep/Pathfinding/SpatialGrid/Geometry) moved
         to the FS.GG.Game.Core bottom layer. Canvas.Tests compiles the re-homed game-profile fragment
         sources (collision/visibility/grids/line-drawing), which now `open FS.GG.Game.Core`, so the
         test project pins it here. Not shipped by any FS.GG.UI.* package in THIS repo — no library
         takes a reference; the generated product pins it via the template's own $(FsGgGameVersion).

         0.3.0 (ADR-0104, #269): adds `Loop`, the double step buffer that supersedes the deprecated
         `FS.GG.UI.Canvas.Loop`. samples/CanvasDemo and samples/SymbologyBoard consume it directly —
         the migration target must be a PACKAGE reference, because re-exporting it from Canvas is the
         `FS.GG.UI.Canvas -> FS.GG.Game.Core` edge ADR-0104 forbids. Below 0.3.0 there is no `Loop`. -->
    <PackageVersion Include="FS.GG.Game.Core" Version="0.7.1" />
    <!-- Issue #245: SkiaViewer.Tests drives the real record-only backend (NullBackend) through the
         same `Audio.play` the generated template hands to `runAppWithAudio`, so the seam is proven
         end-to-end without a window or a device. Test-only: the shipped SkiaViewer package depends on
         FS.GG.Audio.Core alone. -->
    <PackageVersion Include="FS.GG.Audio.Host" Version="0.1.0" />
    <PackageVersion Include="Expecto" Version="10.2.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="YoloDev.Expecto.TestSdk" Version="0.16.0" />
  </ItemGroup>
  <!-- Build-tooling only (build/** projects, NOT src/** and NOT shipped in any
       generated product). Consumed as ordinary NuGet libraries by the compiled
       FAKE build front-end (build/Build.fsproj) via `dotnet run`, NOT via the
       FSX script runner. Version matches the pinned fake-cli tool
       (.config/dotnet-tools.json) and build.fsx.lock (6.1.4). No
       FSharp.Compiler.Service (FR-012). See docs/reports/dependencies.md. -->
  <ItemGroup>
    <PackageVersion Include="Fake.Core.Target" Version="6.1.4" />
  </ItemGroup>
  <!-- Build-tooling adopt-set (feature 040). Referenced ONLY by the tangle
       examples project (build/SkillExamples) and tests/Governance.Tests so the
       capability-skill cookbook snippets compile against the real pinned APIs.
       NOT shipped in any generated product; NO FSharp.Compiler.Service (FR-008).
       See docs/reports/dependencies.md and the capability report §9. -->
  <ItemGroup>
    <PackageVersion Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageVersion Include="XParsec" Version="1.0.0" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.9" />
    <PackageVersion Include="Fake.IO.FileSystem" Version="6.1.4" />
    <PackageVersion Include="Fake.Tools.Git" Version="6.1.4" />
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <PackageVersion Include="FsCheck" Version="3.3.3" />
  </ItemGroup>
</Project>
