<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!--#if (profile == "game" || profile == "sample-pack") -->
    <!-- Feature 250: the collision-safe Vec2 helper (fs-gg-model-swap / fs-gg-game-core skills).
         Consumer-owned, adaptable source — compiled before Model.fs so the starter (and your own model)
         can express entity positions/velocities as Geometry.Vec2 without reusing Scene.Point/Rect field
         labels. The Exists guard keeps the build green if you delete the file AFTER swapping Model.fs off
         it (Product.fsproj stays "durable"). -->
    <Compile Include="Vec2.fs" Condition="Exists('Vec2.fs')" />
    <!-- Feature 246: the import-and-adapt collision helper (fs-gg-collision skill). Consumer-owned,
         adaptable source — compiled before Model.fs so your update can call Collision.step. The
         Exists guard keeps the build green if you delete the file (Product.fsproj stays "durable"). -->
    <Compile Include="Collision.fs" Condition="Exists('Collision.fs')" />
    <!-- Feature 247: the import-and-adapt visibility helper (fs-gg-visibility skill). Consumer-owned,
         adaptable source — compiled before Model.fs so your update/view can call Visibility.polygon.
         The Exists guard keeps the build green if you delete the file (Product.fsproj stays "durable"). -->
    <Compile Include="Visibility.fs" Condition="Exists('Visibility.fs')" />
    <!-- Feature 249: the import-and-adapt grid-parts helper (fs-gg-grids skill). Consumer-owned,
         adaptable source — compiled before Model.fs so your update/view can call Grids.cellEdges etc.
         The Exists guard keeps the build green if you delete the file (Product.fsproj stays "durable"). -->
    <Compile Include="Grids.fs" Condition="Exists('Grids.fs')" />
    <!-- Feature 248: the import-and-adapt line-drawing helper (fs-gg-line-drawing skill).
         Consumer-owned, adaptable source — compiled before Model.fs so your update/view can call
         LineDrawing.line / supercover / lineOfSight. The Exists guard keeps the build green if you
         delete the file (Product.fsproj stays "durable"). -->
    <Compile Include="LineDrawing.fs" Condition="Exists('LineDrawing.fs')" />
    <!--#endif -->
    <Compile Include="Model.fs" />
    <Compile Include="View.fs" />
    <Compile Include="LayoutEvidence.fs" />
    <!--#if (profile == "game") -->
    <!-- Issue #245: the product-owned `Msg -> AudioEffect list` cue map and asset resolver. Compiles
         after Model.fs (it names your Msg cases and reads your Model) and before EvidenceCommands.fs
         (which lifts its output onto ViewerEffect.PlayAudio). Replaceable: rewrite it with the model.
         `game` only, not `sample-pack`: the two profiles ship DIFFERENT starter Msg types, and this
         file is written against the game's Pong-style one. sample-pack keeps referencing the
         FS.GG.Audio packages, as it did before. -->
    <Compile Include="AudioCues.fs" />
    <!--#endif -->
    <!--#if (profile == "app" || profile == "sample-pack" || profile == "game") -->
    <Compile Include="WindowOptions.fs" />
    <!--#endif -->
    <Compile Include="EvidenceCommands.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FS.GG.UI.Scene" />
    <!--#if (profile == "game" || profile == "sample-pack") -->
    <!-- ADR-0022 P5: simulation primitives (FixedStep.drain, Rng, Pathfinding, SpatialGrid, Geometry)
         for the fs-gg-game-core / -collision / -visibility / -line-drawing / -grids skills — now in
         FS.GG.Game.Core, the BCL-only bottom layer (moved out of FS.GG.UI.Canvas/.Scene). -->
    <PackageReference Include="FS.GG.Game.Core" />
    <!-- FS.GG.UI.Canvas stays on simulation profiles for the Persistence request surface
         (PersistenceEffect, Persistence.interpret; Feature 244, fs-gg-persistence). Its Audio
         request surface was RETIRED at the Canvas 0.3.0 major (ADR-0024, Rendering#158) — the
         AudioEffect vocabulary now lives in FS.GG.Audio.Core, referenced just below. -->
    <PackageReference Include="FS.GG.UI.Canvas" />
    <!-- FS.GG.Audio (standalone repo, $(FsGgAudioVersion) axis): the single home of the pure
         AudioEffect vocabulary (Core) AND its real host-side realization — buses, fades/ducking, 3D,
         and a device backend that degrades to a headless Null/record path (so tests stay
         deterministic and hardware-free). Elmish is the Audio.Cmd authoring bridge for the game's
         MVU loop. See ADR-0024 / fs-gg-audio skill. -->
    <PackageReference Include="FS.GG.Audio.Core" />
    <PackageReference Include="FS.GG.Audio.Host" />
    <PackageReference Include="FS.GG.Audio.Engine" />
    <PackageReference Include="FS.GG.Audio.Elmish" />
    <!--#endif -->
    <!--#if (profile == "app" || profile == "sample-pack" || profile == "game") -->
    <PackageReference Include="FS.GG.UI.SkiaViewer" />
    <PackageReference Include="FS.GG.UI.Elmish" />
    <!--#endif -->
    <!--#if (profile == "app" || profile == "sample-pack" || profile == "game") -->
    <PackageReference Include="FS.GG.UI.KeyboardInput" />
    <PackageReference Include="FS.GG.UI.Layout" />
    <PackageReference Include="FS.GG.UI.Controls" />
    <PackageReference Include="FS.GG.UI.Controls.Elmish" />
    <!-- Feature 125: design-system primitives + default theme carved out of Controls. -->
    <PackageReference Include="FS.GG.UI.DesignSystem" />
    <PackageReference Include="FS.GG.UI.Themes.Default" />
    <!-- Issue #430: the pure channel-grammar vocabulary (Symbology, Scene-only) and its headless
         Scene->PNG design-loop bridge (Symbology.Render, which reaches SkiaViewer's ReferenceRendering
         path). Both are what the fs-gg-symbology skill and the bundled docs/api-surface/Symbology*
         reference tell an author to `open`; without the references that instruction did not compile. -->
    <PackageReference Include="FS.GG.UI.Symbology" />
    <PackageReference Include="FS.GG.UI.Symbology.Render" />
    <!--#endif -->
    <!-- Issue #432: FS.GG.UI.Testing was referenced here on `governed`, but no product source has ever
         used it — its only consumer is tests/Product.Tests. It now lives on Product.Tests.fsproj, on every
         profile, so the fs-gg-testing skill compiles everywhere it materializes without the product
         carrying a test-only dependency. -->
  </ItemGroup>

</Project>
