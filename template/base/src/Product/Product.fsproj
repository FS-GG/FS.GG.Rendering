<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!--#if (profile == "game" || profile == "sample-pack") -->
    <!-- Feature 246: the import-and-adapt collision helper (fs-gg-collision skill). Consumer-owned,
         adaptable source — compiled before Model.fs so your update can call Collision.step. The
         Exists guard keeps the build green if you delete the file (Product.fsproj stays "durable"). -->
    <Compile Include="Collision.fs" Condition="Exists('Collision.fs')" />
    <!-- Feature 247: the import-and-adapt visibility helper (fs-gg-visibility skill). Consumer-owned,
         adaptable source — compiled before Model.fs so your update/view can call Visibility.polygon.
         The Exists guard keeps the build green if you delete the file (Product.fsproj stays "durable"). -->
    <Compile Include="Visibility.fs" Condition="Exists('Visibility.fs')" />
    <!--#endif -->
    <Compile Include="Model.fs" />
    <Compile Include="View.fs" />
    <Compile Include="LayoutEvidence.fs" />
    <!--#if (profile == "app" || profile == "sample-pack" || profile == "game") -->
    <Compile Include="WindowOptions.fs" />
    <!--#endif -->
    <Compile Include="EvidenceCommands.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FS.GG.UI.Scene" />
    <!--#if (profile == "game" || profile == "sample-pack") -->
    <!-- Feature 240 (#73): simulation primitives (FixedStep.drain, Rng) for the fs-gg-game-core skill.
         Feature 243 (#92): also carries the Audio request surface (AudioEffect, Audio.interpret) for
         the fs-gg-audio skill — same package, same gate, no separate reference.
         Feature 244 (#93): also carries the Persistence request surface (PersistenceEffect,
         Persistence.interpret) for the fs-gg-persistence skill — same package, same gate. -->
    <PackageReference Include="FS.GG.UI.Canvas" />
    <!--#endif -->
    <!--#if (profile == "app" || profile == "sample-pack" || profile == "game") -->
    <PackageReference Include="FS.GG.UI.SkiaViewer" />
    <PackageReference Include="FS.GG.UI.Elmish" />
    <!--#endif -->
    <!--#if (profile == "app" || profile == "sample-pack" || profile == "game") -->
    <PackageReference Include="FS.GG.UI.KeyboardInput" />
    <PackageReference Include="FS.GG.UI.Layout" />
    <PackageReference Include="FS.GG.UI.Controls" />
    <PackageReference Include="FS.GG.UI.Controls.Elmish" />
    <!-- Feature 125: design-system primitives + default theme carved out of Controls. -->
    <PackageReference Include="FS.GG.UI.DesignSystem" />
    <PackageReference Include="FS.GG.UI.Themes.Default" />
    <!--#endif -->
    <!--#if (profile == "governed") -->
    <PackageReference Include="FS.GG.UI.Testing" />
    <!--#endif -->
  </ItemGroup>

</Project>
