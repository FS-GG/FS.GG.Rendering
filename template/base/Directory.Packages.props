<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- 064 (FR-004): the SINGLE source of FS.GG.UI version truth. Every FS.GG.UI.*
         pin below references $(FsGgUiVersion), and build.fsx reads this property at
         runtime to bind the engine assembly — so a consumer upgrade is ONE edit to this
         value + `dotnet restore`. Preview vs stable is explicit in the value
         (`-preview.N` => preview channel; a bare `x.y.z` => stable). See docs/UPGRADING.md. -->
    <FsGgUiVersion>0.3.0-preview.1</FsGgUiVersion>
    <!-- ADR-0022 P5: the deterministic sim primitives (Rng/FixedStep/Pathfinding/SpatialGrid/
         Geometry) moved OUT of FS.GG.UI.Canvas/.Scene into FS.GG.Game.Core — the platform's
         BCL-only bottom layer, released on its OWN axis (NOT $(FsGgUiVersion)). Game/sample-pack
         products pin it here; simulation profiles only. -->
    <FsGgGameVersion>0.1.0-preview.1</FsGgGameVersion>
    <!-- The standalone FS.GG.Audio component (own repo FS-GG/FS.GG.Audio, released on its OWN
         axis — NOT $(FsGgUiVersion)/$(FsGgGameVersion)). Game/sample-pack products pin it here to
         get the REAL host-side audio realization (named buses, fades/ducking, 3D, device backend)
         behind the pure AudioEffect edge — the piece the fs-gg-audio skill calls "a real playback
         backend is deferred". Simulation profiles only. See ADR-0024. -->
    <FsGgAudioVersion>0.1.0-preview.1</FsGgAudioVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- 043 (FR-013): the published governance engine consumed in-process by the
         generated build.fsx; pinned for every profile and bumped with the other
         FS.GG.UI.* packages via the single $(FsGgUiVersion) above. -->
    <PackageVersion Include="FS.GG.UI.Build" Version="$(FsGgUiVersion)" />
    <PackageVersion Include="FS.GG.UI.Scene" Version="$(FsGgUiVersion)" />
    <!--#if (profile == "game" || profile == "sample-pack") -->
    <!-- ADR-0022 P5: the sim primitives (FixedStep/Rng/Pathfinding/SpatialGrid/Geometry) that the
         fs-gg-game-core / -collision / -visibility / -line-drawing / -grids skills use now live in
         FS.GG.Game.Core (the BCL-only bottom layer), consumed on its own $(FsGgGameVersion) axis. -->
    <PackageVersion Include="FS.GG.Game.Core" Version="$(FsGgGameVersion)" />
    <!-- FS.GG.UI.Canvas is still referenced on simulation profiles for the Audio request surface
         (AudioEffect/Audio.interpret, fs-gg-audio; Feature 243) and the Persistence request surface
         (fs-gg-persistence; Feature 244) — it no longer carries the sim primitives (ADR-0022 P5). -->
    <PackageVersion Include="FS.GG.UI.Canvas" Version="$(FsGgUiVersion)" />
    <!-- FS.GG.Audio: the real host-side realization of the pure AudioEffect edge (standalone repo,
         $(FsGgAudioVersion) axis). Core = request vocabulary + record interpreter (headless default);
         Host = IAudioBackend device seam (Null/record + OpenAL, degrade-to-Null); Engine = buses /
         fades / ducking / 3D; Elmish = Audio.Cmd authoring bridge. See ADR-0024. -->
    <PackageVersion Include="FS.GG.Audio.Core" Version="$(FsGgAudioVersion)" />
    <PackageVersion Include="FS.GG.Audio.Host" Version="$(FsGgAudioVersion)" />
    <PackageVersion Include="FS.GG.Audio.Engine" Version="$(FsGgAudioVersion)" />
    <PackageVersion Include="FS.GG.Audio.Elmish" Version="$(FsGgAudioVersion)" />
    <!--#endif -->
    <!--#if (profile == "app" || profile == "sample-pack" || profile == "game") -->
    <PackageVersion Include="FS.GG.UI.SkiaViewer" Version="$(FsGgUiVersion)" />
    <PackageVersion Include="FS.GG.UI.Elmish" Version="$(FsGgUiVersion)" />
    <!--#endif -->
    <!--#if (profile == "app" || profile == "sample-pack" || profile == "game") -->
    <PackageVersion Include="FS.GG.UI.KeyboardInput" Version="$(FsGgUiVersion)" />
    <PackageVersion Include="FS.GG.UI.Layout" Version="$(FsGgUiVersion)" />
    <PackageVersion Include="FS.GG.UI.Controls" Version="$(FsGgUiVersion)" />
    <PackageVersion Include="FS.GG.UI.Controls.Elmish" Version="$(FsGgUiVersion)" />
    <!-- Feature 125: design-system primitives + default theme carved out of Controls. -->
    <PackageVersion Include="FS.GG.UI.DesignSystem" Version="$(FsGgUiVersion)" />
    <PackageVersion Include="FS.GG.UI.Themes.Default" Version="$(FsGgUiVersion)" />
    <!--#endif -->
    <!--#if (profile == "governed") -->
    <PackageVersion Include="FS.GG.UI.Testing" Version="$(FsGgUiVersion)" />
    <!--#endif -->
    <PackageVersion Include="Expecto" Version="10.2.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageVersion Include="YoloDev.Expecto.TestSdk" Version="0.15.6" />
  </ItemGroup>
</Project>
